import { site } from "./site";

export type LegalSection = {
  title: string;
  body: string[];
};

export type LegalDocument = {
  title: string;
  intro: string;
  sections: LegalSection[];
};

export const privacyPolicy: LegalDocument = {
  title: "Privacy Policy",
  intro: `${site.appName} is built to be played on a single device, in the same room, with no account and no internet connection. This policy explains the simple truth behind that: the app keeps your information on your device and does not send it to us.`,
  sections: [
    {
      title: "The Short Version",
      body: [
        `${site.appName} does not require an account, does not ask you to sign in, and does not send your data to ${site.developerName} or anyone else.`,
        "Everything you create while playing (player names, scores, and game settings) is stored only on the device you are playing on. The app works fully offline.",
      ],
    },
    {
      title: "What We Store (On-Device Only)",
      body: [
        "To let you keep playing across rounds and sessions, the app saves a small amount of information in your device's local storage, such as the player names you type in, scores from games you have played, and your in-app settings and preferences.",
        "This information stays on your device. It is not transmitted to our servers, because the app has no servers it talks to in order to play.",
      ],
    },
    {
      title: "What We Don't Collect",
      body: [
        `We do not collect personal information, and we do not have user accounts. ${site.developerName} cannot see the names, scores, or settings on your device.`,
        "We do not use analytics, advertising, or third-party tracking of any kind. The app does not include ad networks, marketing trackers, or behavioral profiling.",
        "We do not require location, contacts, microphone, camera, or other sensitive device permissions in order to play.",
      ],
    },
    {
      title: "Optional Features Not Active in This Version",
      body: [
        "Optional sign-in, in-app purchases, and push notifications are not enabled in this version of the app. As shipped, the app does not connect to an account system, a payment provider, or a notification service.",
        "If a future version enables any of these features, we will update this Privacy Policy before that version is released, name the providers we use (for example, the platform's app store for purchases or its push notification service), and explain what data is involved.",
      ],
    },
    {
      title: "Works Offline",
      body: [
        "The app is designed to run without a network connection. You can play in airplane mode. Because there is no required network activity for gameplay, there is no game data flowing to us during play.",
      ],
    },
    {
      title: "Children and General Audiences",
      body: [
        `${site.appName} is a general-audience party game and is not directed at children under the age where parental consent would be required in your region.`,
        "Because the app does not collect personal information or require an account, it does not knowingly gather data from anyone, including children.",
      ],
    },
    {
      title: "Your Control Over Your Data",
      body: [
        "Because your data lives on your device, you are in control of it. Clearing the app's data or deleting the app removes the player names, scores, and settings stored on that device.",
        "Note that your device's operating system or backups (for example, an iCloud or Android device backup) may retain app data independently of the app, according to that platform's own settings and policies.",
      ],
    },
    {
      title: "Changes to This Policy",
      body: [
        "We may update this Privacy Policy as the app evolves, for example if we later enable optional sign-in, purchases, or notifications. When we make a material change, we will update the effective date above and, where appropriate, note the change in the app or on this page.",
      ],
    },
    {
      title: "Contact",
      body: [
        `If you have questions about this Privacy Policy, contact ${site.developerName} at ${site.supportEmail}.`,
      ],
    },
  ],
};

